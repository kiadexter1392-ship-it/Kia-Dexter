{
  "expo": {
    "name": "ارسلان دوجو",
    "slug": "arslan-dojo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#1a1a1a"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.arsalandojo.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1a1a"
      },
      "package": "com.arsalandojo.app"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
